{
  "name": "wdd430-portforlio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit --incremental false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "npx tsx src/database/seeder.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^1.0.0-rc.5",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^1.0.0-rc.5",
    "drizzle-seed": "^1.0.0-rc.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
